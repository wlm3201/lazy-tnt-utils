{
	"schemaVersion": 1,
	"id": "lazytntutils",
	"version": "${version}",
	"name": "Lazy TNT Utils",
	"description": "Accurate TNT and entity state in lazy chunks: fuse timers, motion vectors and precise explosion particles.",
	"authors": ["wlm3201"],
	"contact": {
		"sources": "https://github.com/wlm3201/lazy-tnt-utils"
	},
	"license": "MIT",
	"icon": "assets/lazytntutils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.lazytntutils.LazyTNTUtils"],
		"client": ["com.lazytntutils.client.LazyTNTUtilsClient"],
		"modmenu": ["com.lazytntutils.client.ModMenuIntegration"]
	},
	"mixins": [
		"lazytntutils.mixins.json",
		{
			"config": "lazytntutils.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
